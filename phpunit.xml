<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <exclude>tests/Unit/Console/Commands</exclude>
        </testsuite>
        <testsuite name="Modules">
            <directory>Modules/*/Tests</directory>
            <exclude>Modules/*/Tests/Browser</exclude>
        </testsuite>
        <testsuite name="browser">
            <directory>tests/Browser</directory>
            <directory>Modules/*/Tests/Browser</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>integration</group>
            <group>slow</group>
            <group>browser</group>
            <group>performance</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
            <directory>Modules</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- COVERAGE & PARALLEL EXECUTION: IMPORTANT TRADE-OFF

             DISCOVERED ISSUE (Phase 5 Audit):
             - Running "pest --parallel --processes=10" WITH coverage hits OOM at 2GB.
             - Root cause: ParaTest's CoverageMerger aggregates ~600KB-1MB XML per worker in memory.
             - 10 workers × ~1MB + merge overhead = exhausts 2GB heap during XML aggregation.

             SOLUTION (Phase 5 Implementation):
             - Local dev: Use parallel EITHER alone OR coverage alone (not both).
               * Fast feedback: "./vendor/bin/pest --parallel --processes=10" (2 min, no coverage)
               * Full coverage: "XDEBUG_MODE=coverage php ./vendor/bin/pest" (8-10 min, sequential)
             - CI/CD: Run tests parallel FIRST (no coverage), then coverage separately on single process.
               * Test execution: 2 min (parallel, no coverage)
               * Coverage collection: 8 min (sequential, single process)
               * Mutation testing: 30-45 min (after coverage XML is ready)

             RESULT: Avoids OOM, maintains speed (parallel for tests) and accuracy (sequential coverage).
        -->
        <env name="XDEBUG_MODE" value="coverage"/>
        <!-- Memory limit: 2048M baseline for parallel execution. For sequential coverage collection,
             increase to 3G. For mutation testing (which requires larger coverage XML), may need 4G. -->
        <ini name="memory_limit" value="2048M"/>
        <!-- Enable garbage collection: set higher (1 = immediate, 0 = disabled) -->
        <ini name="zend.enable_gc" value="1"/>
        <ini name="report_memleaks" value="0"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Database Configuration for Testing -->
        <!-- Option 1: SQLite (RECOMMENDED for unit tests - 10-20x faster) -->
        <!--   - Best for: Rapid unit testing, TDD workflow -->
        <!--   - Install: sudo apt-get install php8.3-sqlite3 -->
        <!--   - Trade-off: Some feature tests may fail (MySQL-specific queries) -->
        <!--   - Parallel support: Uses {DB_DATABASE} token replaced per worker -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <!-- Option 2: MySQL (RECOMMENDED for full integration testing) -->
        <!--   - Best for: Complete feature test suite, CI/CD pipelines -->
        <!--   - Trade-off: Slower (first test ~5s vs 0.12s with SQLite) -->
        <!--   - To use: Comment out SQLite lines above, uncomment MySQL below -->
        <!-- <env name="DB_CONNECTION" value="mysql"/> -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="LOG_CHANNEL" value="null"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="STRIPE_SECRET" value="sk_test_dummy"/>
        <env name="SENTRY_TRACES_SAMPLE_RATE" value="0.1"/>
    </php>
</phpunit>
