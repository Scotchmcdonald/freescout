<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <exclude>tests/Unit/Console/Commands</exclude>
        </testsuite>
        <testsuite name="Modules">
            <directory>Modules/*/Tests</directory>
            <exclude>Modules/*/Tests/Browser</exclude>
        </testsuite>
        <testsuite name="browser">
            <directory>tests/Browser</directory>
            <directory>Modules/*/Tests/Browser</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>integration</group>
            <group>slow</group>
            <group>browser</group>
            <group>performance</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
            <directory>Modules</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Coverage: ensure Xdebug coverage mode is active in every parallel worker subprocess -->
        <env name="XDEBUG_MODE" value="coverage"/>
        <!-- Memory limit: raised to 2048M so ParaTest coverage merger can aggregate all workers.
             512M was the authoritative fork-time ceiling and caused OOM in CoverageMerger.php:27 -->
        <ini name="memory_limit" value="2048M"/>
        <!-- Enable garbage collection: set higher (1 = immediate, 0 = disabled) -->
        <ini name="zend.enable_gc" value="1"/>
        <ini name="report_memleaks" value="0"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Database Configuration for Testing -->
        <!-- Option 1: SQLite (RECOMMENDED for unit tests - 10-20x faster) -->
        <!--   - Best for: Rapid unit testing, TDD workflow -->
        <!--   - Install: sudo apt-get install php8.3-sqlite3 -->
        <!--   - Trade-off: Some feature tests may fail (MySQL-specific queries) -->
        <!--   - Parallel support: Uses {DB_DATABASE} token replaced per worker -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <!-- Option 2: MySQL (RECOMMENDED for full integration testing) -->
        <!--   - Best for: Complete feature test suite, CI/CD pipelines -->
        <!--   - Trade-off: Slower (first test ~5s vs 0.12s with SQLite) -->
        <!--   - To use: Comment out SQLite lines above, uncomment MySQL below -->
        <!-- <env name="DB_CONNECTION" value="mysql"/> -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="LOG_CHANNEL" value="null"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="STRIPE_SECRET" value="sk_test_dummy"/>
        <env name="SENTRY_TRACES_SAMPLE_RATE" value="0.1"/>
    </php>
</phpunit>
