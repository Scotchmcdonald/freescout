{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "Modules/Action1/Services",
            "Modules/AssetManagement/Services",
            "Modules/ContractManager/Services",
            "Modules/Payment/Services",
            "Modules/PIB/Services",
            "Modules/SoftwareSubscriptions/Services"
        ]
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 95,
    "minCoveredMsi": 95,
    // Per-mutant timeout in seconds (required with --skip-initial-tests).
    "timeout": 30,
    "testFramework": "phpunit",
    "phpUnit": {
        "customPath": "scripts/pest-phpunit-wrapper",
        "configDir": "config/infection"
    },
    "tmpDir": "storage/infection",
    "logs": {
        "text": "reports/infection.log",
        "summaryJson": "reports/infection-summary.json"
    }
}
