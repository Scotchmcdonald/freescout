# syntax=docker/dockerfile:1.7

# =============================================================================
# TreeScout Production Image
#
# Built by GitHub Actions (.github/workflows/build-and-push.yml).
# Private module repos are cloned by CI before running this build.
# DO NOT build locally unless you have all private module repos checked out
# under Modules/.
#
# Tags: ghcr.io/borealtek/treescout:{profile}-latest
#        ghcr.io/borealtek/treescout:{profile}-{git-sha}
# =============================================================================

# ── Stage 1: Frontend assets ─────────────────────────────────────────────────
# Compile JS/CSS. Modules/ must be present for any module-specific assets.
FROM node:22-alpine AS node-builder

WORKDIR /app

# Layer cache: copy manifests first
COPY package.json package-lock.json ./
COPY vite.config.js tailwind.config.js postcss.config.js ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline

# Copy full source (Modules/ pre-cloned by CI)
COPY . .

RUN npm run build

# ── Stage 2: PHP application ──────────────────────────────────────────────────
FROM serversideup/php:8.3-fpm-nginx AS app

ARG PROFILE=full
ARG BUILD_DATE
ARG VCS_REF

LABEL org.opencontainers.image.title="TreeScout" \
    org.opencontainers.image.description="TreeScout MSP platform — profile: ${PROFILE}" \
    org.opencontainers.image.created="${BUILD_DATE}" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.source="https://github.com/Scotchmcdonald/freescout" \
    treescout.profile="${PROFILE}"

USER root

# Install PHP extensions — no xdebug in production
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip \
    && curl -sSLf \
    -o /usr/local/bin/install-php-extensions \
    https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions \
    && chmod +x /usr/local/bin/install-php-extensions \
    && install-php-extensions imap gmp soap intl bcmath gd redis sockets \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# PHP production tuning (opcache, realpath cache)
RUN printf "opcache.enable=1\n\
    opcache.validate_timestamps=0\n\
    opcache.memory_consumption=256\n\
    opcache.max_accelerated_files=20000\n\
    realpath_cache_size=4096K\n\
    realpath_cache_ttl=600\n" \
    > /usr/local/etc/php/conf.d/zzz-prod.ini

WORKDIR /var/www/html

# Copy application source (Modules/ already present in context)
COPY --chown=www-data:www-data . .

# Replace compiled frontend assets with the node-builder output
COPY --from=node-builder --chown=www-data:www-data /app/public/build ./public/build

# Bake in nginx config — no bind mount in production
# Cloudflare tunnel terminates TLS; nginx serves plain HTTP on 8080
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Install PHP dependencies — production only, optimised autoloader
RUN --mount=type=cache,target=/tmp/composer-cache \
    COMPOSER_CACHE_DIR=/tmp/composer-cache \
    composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

# Set permissions
RUN mkdir -p /var/www/html/bootstrap/cache \
    /var/www/html/storage/app \
    /var/www/html/storage/framework/cache/data \
    /var/www/html/storage/framework/sessions \
    /var/www/html/storage/framework/views \
    /var/www/html/storage/logs \
    && chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache \
    && find /var/www/html/storage -type d -exec chmod 775 {} + \
    && find /var/www/html/bootstrap/cache -type d -exec chmod 775 {} +

# Startup script: clear compiled caches so they rebuild against the live .env
# (config/route/view caches would contain values from the CI build environment)
RUN printf '#!/bin/sh\ncd /var/www/html\n\
    php artisan config:clear  2>/dev/null || true\n\
    php artisan route:clear   2>/dev/null || true\n\
    php artisan view:clear    2>/dev/null || true\n' \
    > /etc/entrypoint.d/50-clear-caches.sh \
    && chmod +x /etc/entrypoint.d/50-clear-caches.sh

# Fix storage permissions at startup (handles first-run named-volume ownership drift)
RUN printf '#!/bin/sh\n\
    chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache 2>/dev/null || true\n' \
    > /etc/entrypoint.d/40-fix-permissions.sh \
    && chmod +x /etc/entrypoint.d/40-fix-permissions.sh

USER www-data
