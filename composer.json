{
    "name": "freescout-helpdesk/freescout-modern",
    "type": "project",
    "description": "Modern Laravel 11 FreeScout - Self-hosted helpdesk and shared mailbox",
    "keywords": [
        "helpdesk",
        "help desk",
        "shared mailbox",
        "support",
        "customer service",
        "laravel"
    ],
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "doctrine/dbal": "^4.0",
        "enshrined/svg-sanitize": "^0.22",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^7.8",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/framework": "^12.0",
        "laravel/reverb": "^1.6",
        "laravel/socialite": "^5.23",
        "laravel/tinker": "^2.9",
        "mews/purifier": "^3.4",
        "nwidart/laravel-modules": "^12.0",
        "owenvoke/blade-entypo": "^2.3",
        "qirolab/laravel-themer": "^2.4",
        "sentry/sentry-laravel": "*",
        "spatie/laravel-activitylog": "^4.8",
        "tormjens/eventy": "^0.9.4",
        "watson/rememberable": "^7.0",
        "webklex/php-imap": "^6.2",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "brianium/paratest": "*",
        "fakerphp/faker": "^1.23",
        "icanhazstring/composer-unused": "*",
        "infection/infection": "^0.32.6",
        "larastan/larastan": "^3.8",
        "laravel/breeze": "^2.3",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-browser": "^4.2",
        "phpunit/phpcov": "*",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/"
        },
        "exclude-from-classmap": [
            "./Modules/CaseManager/Tests/Unit/Traits/AiPipelineFailureHandlerTest.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "@apply-infection-patches"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@apply-infection-patches"
        ],
        "apply-infection-patches": [
            "bash scripts/apply-infection-patches.sh"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test": [
            "@test:fast"
        ],
        "test:fast": [
            "APP_ENV=testing DB_CONNECTION=sqlite DB_DATABASE=:memory: CACHE_STORE=array SESSION_DRIVER=array QUEUE_CONNECTION=sync php -d pcov.directory=. artisan test --parallel --processes=${TEST_PROCESSES:-10}"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "format": [
            "vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true,
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}