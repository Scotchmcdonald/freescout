# =============================================================================
# TreeScout Deployment Manager — Environment Variables
# Copy relevant lines to your application .env file
# =============================================================================

# ── Git Provider ─────────────────────────────────────────────────────────────
# Which provider to use: 'gitlab' (default) or 'github'
TSDM_GIT_PROVIDER=gitlab

# GitLab settings (when TSDM_GIT_PROVIDER=gitlab)
# Admin PAT with 'api' scope — NEVER commit this value
TSDM_GITLAB_HOST=https://gitlab.com
TSDM_GITLAB_ADMIN_TOKEN=glpat-XXXXXXXXXXXXXXXXXXXX
TSDM_GITLAB_PROJECT_ID=12345678

# GitHub App settings (when TSDM_GIT_PROVIDER=github)
TSDM_GITHUB_APP_ID=
TSDM_GITHUB_PRIVATE_KEY_PATH=/etc/secrets/github-app.pem
TSDM_GITHUB_INSTALLATION_ID=

# ── Activation Codes ─────────────────────────────────────────────────────────
# Default TTL for newly issued OTACs (hours). Range: 1–168.
TSDM_OTAC_TTL_HOURS=24

# GitLab access level granted to issued tokens (20 = Reporter / read-only)
TSDM_GITLAB_ACCESS_LEVEL=20

# ── Security ──────────────────────────────────────────────────────────────────
# Lock activated token to the IP that first redeemed the OTAC
# Recommended: true for production
TSDM_IP_PINNING=false
