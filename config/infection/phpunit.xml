<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lean PHPUnit configuration used exclusively by Infection mutation testing.

  Includes all test suites whose tests may cover the mutation scope defined
  in infection-extended.json5 (app/Services, app/Actions, app/Jobs, and
  module Services/Jobs directories).

  When Infection uses "only-covering-test-cases" mode, it selects only the
  tests that actually cover each mutant. This config just needs to make all
  potentially-covering test files available.
-->
<phpunit bootstrap="../../vendor/autoload.php" colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>../../tests/Unit</directory>
            <exclude>../../tests/Unit/Console/Commands</exclude>
        </testsuite>
        <testsuite name="Feature">
            <directory>../../tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>../../tests/Integration</directory>
        </testsuite>
        <testsuite name="Action1">
            <directory>../../Modules/Action1/Tests</directory>
        </testsuite>
        <testsuite name="AssetManagement">
            <directory>../../Modules/AssetManagement/Tests</directory>
        </testsuite>
        <testsuite name="CaseManager">
            <directory>../../Modules/CaseManager/Tests</directory>
        </testsuite>
        <testsuite name="ContractManager">
            <directory>../../Modules/ContractManager/Tests</directory>
        </testsuite>
        <testsuite name="Crm">
            <directory>../../Modules/Crm/Tests</directory>
        </testsuite>
        <testsuite name="Payment">
            <directory>../../Modules/Payment/Tests</directory>
        </testsuite>
        <testsuite name="PIB">
            <directory>../../Modules/PIB/Tests</directory>
        </testsuite>
        <testsuite name="SoftwareSubscriptions">
            <directory>../../Modules/SoftwareSubscriptions/Tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>../../app/Services</directory>
            <directory>../../app/Actions</directory>
            <directory>../../app/Jobs</directory>
            <directory>../../Modules/Action1/Services</directory>
            <directory>../../Modules/Action1/Jobs</directory>
            <directory>../../Modules/AssetManagement/Services</directory>
            <directory>../../Modules/CaseManager/Services</directory>
            <directory>../../Modules/CaseManager/Jobs</directory>
            <directory>../../Modules/ContractManager/Services</directory>
            <directory>../../Modules/Crm/Services</directory>
            <directory>../../Modules/Payment/Services</directory>
            <directory>../../Modules/Payment/Jobs</directory>
            <directory>../../Modules/PIB/Services</directory>
            <directory>../../Modules/PIB/Jobs</directory>
            <directory>../../Modules/SoftwareSubscriptions/Services</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="XDEBUG_MODE" value="coverage"/>
        <ini name="memory_limit" value="512M"/>
        <ini name="zend.enable_gc" value="1"/>
        <ini name="report_memleaks" value="0"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="LOG_CHANNEL" value="null"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="STRIPE_SECRET" value="sk_test_dummy"/>
        <env name="SENTRY_TRACES_SAMPLE_RATE" value="0.1"/>
    </php>
</phpunit>
