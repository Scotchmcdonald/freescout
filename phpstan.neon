includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - bootstrap/app.php
        - config
        - database/factories
        - database/migrations
        - database/seeders
        - routes
        - Modules
    
    # Ignore patterns
    excludePaths:
        - archive/*
        - vendor/*
        - storage/*
        - bootstrap/cache/*
        - tests/*
        - */Tests/*
        - */tests/*
        - deployment/*
        - scripts/*
        - resources/*
        - public/*
        - themes/*
        - node_modules/*
        - reports/*
        - */vendor/*
        - **/node_modules/*

    ignoreErrors:
        -
            message: '#Called ''env'' outside of the config directory#'
            path: 'Modules/*/Config/*.php'
        -
            message: '#Called ''env'' outside of the config directory#'
            path: 'Modules/**/config/*.php'

        # Faker magic properties and methods (provided by locale providers at runtime)
        -
            message: '#Access to an undefined property Faker\\Generator::\$state#'
            path: 'Modules/Crm/Database/Factories/CompanyFactory.php'
        -
            message: '#Call to an undefined method Faker\\Generator::stateAbbr\(\)#'
            path: 'Modules/Payment/Database/Factories/PaymentMethodFactory.php'

        # Sentry Breadcrumb API - setMetadata/setMessage are valid methods
        # in Sentry SDK but not visible to PHPStan due to __call magic
        -
            message: '#Call to an undefined method Sentry\\Breadcrumb::(setMetadata|setMessage)\(\)#'
            path: 'config/sentry.php'

        # Webklex PHPIMAP - getInternalDate() exists but is not in the
        # PHPDoc/type stubs for the Message class
        -
            message: '#Call to an undefined method Webklex\\PHPIMAP\\Message::getInternalDate\(\)#'
            paths:
                - 'Modules/EmailMigration/Jobs/*.php'

        # ForeignKeyDefinition::comment() - not available; chaining comment()
        # after a foreign key definition is not supported in this Laravel version
        -
            message: '#Call to an undefined method Illuminate\\Database\\Schema\\ForeignKeyDefinition::comment\(\)#'
            path: 'Modules/KnowledgeBase/database/migrations/*'

        # whereHas() callback Builder generic subtype mismatch — PHPStan
        # assigns Builder<Model> to the closure parameter, but @var
        # narrows to a concrete model's Builder which isn't a valid subtype.
        # This is a known PHPStan limitation with closure parameter typing.
        -
            identifier: varTag.nativeType
            paths:
                - 'Modules/Alerts/Services/AlertService.php'
                - 'app/Http/Controllers/ReconciliationController.php'

        # Unused traits — may be used in tests or future code outside
        # the analysed paths
        -
            identifier: trait.unused

        # Unused methods/properties/constants — kept for future use or
        # used via reflection/serialization not visible to static analysis
        -
            identifier: method.unused
        -
            identifier: property.onlyWritten
        -
            identifier: classConstant.unused

        # Return type unions where one branch is never used — intentional
        # interface compliance or defensive typing
        -
            identifier: return.unusedType

        # VerifyWebhookSignature — IP range scaffolding with placeholder
        # values, will be populated with real IPs later
        -
            message: '#(always evaluate to true|always evaluate to false|always true|always false)#'
            path: 'app/Http/Middleware/VerifyWebhookSignature.php'

        # PaymentServiceProvider — method_exists guard for optional CRM
        # module (ExtensibleModel may not be loaded at runtime)
        -
            identifier: function.alreadyNarrowedType
            path: 'Modules/Payment/Providers/PaymentServiceProvider.php'

        # Module views use 'module::view' notation; Larastan cannot
        # resolve view paths from dynamically registered module namespaces
        -
            message: '#Parameter \#1 \$view of function view expects view-string\|null, string given#'
    
    # Laravel specific
    checkModelProperties: true
    checkOctaneCompatibility: true
    treatPhpDocTypesAsCertain: false