includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    reportUnmatchedIgnoredErrors: true
    level: 9
    paths:
        - app
        - bootstrap/app.php
        - config
        - database/factories
        - database/migrations
        - database/seeders
        - routes
        - Modules

    # Ignore patterns
    excludePaths:
        - _ide_helper.php
        - _ide_helper_models.php
        - _ide_helper_pest.php
        - _ide_helper_controller_traits.php
        - intellisense_stubs.php
        - intellisense_framework_stubs.php
        - archive/*
        - vendor/*
        - storage/*
        - bootstrap/cache/*
        - tests/*
        - */Tests/*
        - */tests/*
        - deployment/*
        - scripts/*
        - resources/*
        - public/*
        - themes/*
        - node_modules/*
        - reports/*
        - */vendor/*
        - **/node_modules/*

    ignoreErrors:
        # Module config files legitimately use env() just like main config/*.php
        -
            message: '#Called ''env'' outside of the config directory#'
            path: 'Modules/*/Config/*.php'
        -
            message: '#Called ''env'' outside of the config directory#'
            path: 'Modules/**/config/*.php'

        # Webklex PHPIMAP — getInternalDate() exists but has no type stubs
        -
            message: '#Call to an undefined method Webklex\\PHPIMAP\\Message::getInternalDate\(\)#'
            paths:
                - 'Modules/EmailMigration/Jobs/*.php'

        # Unused code — may be used via reflection, tests, or future code
        -
            identifier: trait.unused
        -
            identifier: method.unused
        -
            identifier: property.onlyWritten
        -
            identifier: return.unusedType

        # Module views use 'module::view' notation; Larastan cannot resolve
        -
            message: '#Parameter \#1 \$view of function view expects view-string\|null, string given#'

    # Laravel specific
    checkModelProperties: true
    checkOctaneCompatibility: true
    treatPhpDocTypesAsCertain: false
