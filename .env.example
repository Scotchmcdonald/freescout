APP_NAME="BorealTek Treescout"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# OrbStack: set to https://yourapp.orb.local and ensure TRUSTED_PROXIES=* is set
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#===============================================================================
# DATABASE
#===============================================================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=freescout
# DB_USERNAME=freescout
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

#===============================================================================
# REDIS
#===============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#===============================================================================
# MAIL
#===============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#===============================================================================
# IMAP (Inbound Email)
#===============================================================================
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_PROTOCOL=imap
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_DEFAULT_ACCOUNT=default

#===============================================================================
# AWS (optional)
#===============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#===============================================================================
# REVERB (WebSockets)
# These placeholder values are overwritten by the deploy script with generated
# credentials. For local dev, run: php artisan reverb:install
#===============================================================================
REVERB_APP_ID=local-app-id
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=local-app-secret
# Internal host: container name in Docker, 0.0.0.0 for local dev
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
# Public host/port used by the browser Echo client
REVERB_SERVER_HOST=localhost
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=""

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_SERVER_HOST}"
VITE_REVERB_PORT="${REVERB_SERVER_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

#===============================================================================
# MAIL PROVIDERS (Optional — configure ONE if not using MAIL_MAILER=smtp)
#===============================================================================
# Postmark
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=
# Resend
RESOURCE_KEY=
RESEND_KEY=

#===============================================================================
# CLOUDFLARE TUNNEL
#===============================================================================
# Obtain from: Zero Trust → Networks → Tunnels → your tunnel → Install connector
TUNNEL_TOKEN=


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Google Workspace API
GOOGLE_CREDENTIALS_PATH=/path/to/service-account.json
GOOGLE_ADMIN_EMAIL=admin@example.com
GOOGLE_ADMIN_EMAILS=
GOOGLE_CUSTOMER_ID=C01234567
GOOGLE_DOMAIN=example.com
GOOGLE_ALLOWED_DOMAINS=example.com
GOOGLE_WEBHOOK_SECRET=
GOOGLE_PUSH_NOTIFICATION_URL=https://yourdomain.com/api/webhooks/google

#===============================================================================
# ACTION1 RMM
#===============================================================================
ACTION1_REGION=us
ACTION1_SYNC_CLIENT_ID=
ACTION1_SYNC_CLIENT_SECRET=
ACTION1_AUTOMATION_RUNNER_CLIENT_ID=
ACTION1_AUTOMATION_RUNNER_CLIENT_SECRET=
ACTION1_SCRIPT_MANAGER_CLIENT_ID=
ACTION1_SCRIPT_MANAGER_CLIENT_SECRET=
ACTION1_SYNC_INTERVAL_HOURS=24
ACTION1_WEBHOOK_SECRET=
ACTION1_DIAGNOSTIC_WEBHOOK_SECRET=
ACTION1_DIAGNOSTIC_CALLBACK_URL=
ACTION1_DEBUG=false
# Optional overrides (usually auto-resolved from region):
# ACTION1_API_BASE_URL=
# ACTION1_TOKEN_URL=
# ACTION1_API_TIMEOUT=30
# ACTION1_RATE_LIMIT=60

#===============================================================================
# GEMINI AI
#===============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=8192
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# Per-task model overrides (optional):
# GEMINI_MODEL_TRIAGE=
# GEMINI_MODEL_INTAKE=
# GEMINI_MODEL_RESEARCH=
# GEMINI_MODEL_RESOLUTION=
# GEMINI_MODEL_BRIEFING=
# GEMINI_MODEL_KEYWORDS=
# GEMINI_MODEL_KB_ASSESS=
# GEMINI_MODEL_KB_RANK=

#===============================================================================
# CASE MANAGER
#===============================================================================
CASEMANAGER_ENABLED=false
CASEMANAGER_AI_NAME=Fern
CASEMANAGER_DECISION_ENGINE=rule
CASEMANAGER_AUTO_RESPOND=false
CASEMANAGER_AUTO_DIAGNOSTICS=false
CASEMANAGER_ALLOW_CLIENTS=true
CASEMANAGER_ALLOW_INTERNAL=true
CASEMANAGER_ALLOW_PROSPECTS=false
CASEMANAGER_ALLOW_UNKNOWN=false
CASEMANAGER_FERN_ENABLED=false
CASEMANAGER_QUICK_WINS=true
CASEMANAGER_MODEL_CHECK=false
CASEMANAGER_THOUGHT_SIGS=false
CASEMANAGER_MAX_QUESTIONS=3
CASEMANAGER_HISTORY_LIMIT=10
CASEMANAGER_HISTORY_LOOKUP=30
CASEMANAGER_KB_CONCIERGE=false
CASEMANAGER_KB_THRESHOLD=0.7
CASEMANAGER_KB_DELAY=5
CASEMANAGER_KB_LOOP=3
CASEMANAGER_TRIAGE_DELAY=10
CASEMANAGER_ERROR_CHECK_DELAY=30
CASEMANAGER_RECURRENCE_DAYS=30
CASEMANAGER_RMM_TIMEOUT=30

#===============================================================================
# HELCIM (Payments)
#===============================================================================
HELCIM_API_TOKEN=
HELCIM_ACCOUNT_ID=
HELCIM_WEBHOOK_SECRET=
# HELCIM_API_URL=https://api.helcim.com/v2
# HELCIM_TIMEOUT=30
# HELCIM_CONVENIENCE_FEE_ENABLED=false
# HELCIM_CONVENIENCE_FEE_PERCENT=0
# HELCIM_CONVENIENCE_FEE_FLAT=0

#===============================================================================
# XDEBUG (Local debugging)
#===============================================================================
XDEBUG_MODE=off
XDEBUG_START_WITH_REQUEST=trigger
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_DISCOVER_CLIENT_HOST=1
XDEBUG_IDEKEY=VSCODE

#===============================================================================
# PAYMENT MODULE
#===============================================================================
PAYMENT_AUTO_PROCESS_ENABLED=false
PAYMENT_SEND_RECEIPTS=true
PAYMENT_NOTIFY_SUCCESS=true
PAYMENT_NOTIFY_FAILED=true
PAYMENT_DAYS_BEFORE_DUE=7
PAYMENT_MAX_RETRY_ATTEMPTS=3
PAYMENT_RETRY_FAILED_HOURS=24
PAYMENT_REFUNDS_ENABLED=true
PAYMENT_REFUND_WINDOW_DAYS=30
PAYMENT_REFUND_REQUIRE_APPROVAL=true
PAYMENT_REQUIRE_SIGNATURE=false
PAYMENT_REQUIRE_DEFAULT=false
PAYMENT_REQUIRE_MANUAL_REVIEW=false
PAYMENT_ALLOW_MULTIPLE_METHODS=true
PAYMENT_AUTO_RECONCILE=true
PAYMENT_EXPIRE_CHECK_ENABLED=true
PAYMENT_CARD_EXPIRING_DAYS=30
PAYMENT_LOG_ALL_REQUESTS=false
# PAYMENT_WEBHOOK_IP_WHITELIST=

#===============================================================================
# CLIENT PORTAL
#===============================================================================
CLIENT_PORTAL_WEBSOCKET_ENABLED=false
CLIENT_SESSION_LIFETIME=120

#===============================================================================
# EMAIL MIGRATION
#===============================================================================
EMAIL_MIGRATION_STUCK_THRESHOLD=3600
MIGRATION_JOB_TIMEOUT=300

#===============================================================================
# TSDM (TreeScout Deployment Manager)
#===============================================================================
TSDM_GIT_PROVIDER=github
TSDM_GITHUB_STATIC_PAT=
# TSDM_GITHUB_APP_ID=
# TSDM_GITHUB_INSTALLATION_ID=
# TSDM_GITHUB_PRIVATE_KEY_PATH=
# TSDM_GITLAB_HOST=
# TSDM_GITLAB_ADMIN_TOKEN=
# TSDM_GITLAB_PROJECT_ID=
# TSDM_GITLAB_ACCESS_LEVEL=30
TSDM_IP_PINNING=true
TSDM_OTAC_TTL_HOURS=24

#===============================================================================
# ACTIVITY LOGGER
#===============================================================================
ACTIVITY_LOGGER_ENABLED=true
ACTIVITY_LOGGER_DELETE_RECORDS_OLDER_THAN_DAYS=365

#===============================================================================
# FOLLOW-UP REMINDERS
#===============================================================================
DEFAULT_FOLLOW_UP_DAYS=3

#===============================================================================
# RATE LIMITING / CIRCUIT BREAKER
#===============================================================================
RATE_LIMITER_DRIVER=redis
GOOGLE_API_RATE_LIMIT=100
ACTION1_API_RATE_LIMIT=60
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

#===============================================================================
# SENTRY (Error Tracking)
#===============================================================================
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
SENTRY_BREADCRUMBS_SQL_QUERIES_ENABLED=true
SENTRY_BREADCRUMBS_SQL_BINDINGS_ENABLED=false
SENTRY_BREADCRUMBS_LOGS_ENABLED=true
SENTRY_BREADCRUMBS_CACHE_ENABLED=true
