{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "Modules/PIB/Services",
            "Modules/ContractManager/Services",
            "Modules/Payment/Services",
            "app/Services",
            "app/Actions"
        ]
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 95,
    "minCoveredMsi": 95,
    "testFramework": "phpunit",
    "phpUnit": {
        "customPath": "vendor/bin/pest"
    },
    "tmpDir": "storage/infection",
    "logs": {
        "text": "reports/infection-extended.log",
        "summaryJson": "reports/infection-extended-summary.json"
    }
}
