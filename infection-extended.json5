{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "Modules/Action1/Services",
            "Modules/AssetManagement/Services",
            "Modules/CaseManager/Services",
            "Modules/ContractManager/Services",
            "Modules/Crm/Services",
            "Modules/Payment/Services",
            "Modules/PIB/Services",
            "Modules/SoftwareSubscriptions/Services",
            "app/Services",
            "app/Actions",
            // Phase 6: extend mutation to queue layer (Jobs for modules with Service coverage)
            // These share the same test suites that already achieve 100% MSI for Services.
            // Controllers are excluded pending dedicated integration test expansion (tracked separately).
            "app/Jobs",
            "Modules/Action1/Jobs",
            "Modules/CaseManager/Jobs",
            "Modules/Payment/Jobs",
            "Modules/PIB/Jobs"
        ]
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 95,
    "minCoveredMsi": 95,
    "testFramework": "phpunit",
    "phpUnit": {
        "customPath": "scripts/pest-phpunit-wrapper",
        "configDir": "config/infection"
    },
    "tmpDir": "storage/infection",
    "logs": {
        "text": "reports/infection-extended.log",
        "summaryJson": "reports/infection-extended-summary.json"
    }
}
